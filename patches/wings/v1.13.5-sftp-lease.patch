@@ -298,0 +306,21 @@ func (c *SFTPServer) serve(listener net.Listener, conf *ssh.ServerConfig) error
+// watchRelayLease disconnects every channel on permission loss or callback failure.
+// The bearer is an opaque authorization receipt, not the user's password or key.
+func (c *SFTPServer) watchRelayLease(ctx context.Context, conn *ssh.ServerConn, lease string) {
+	ticker := time.NewTicker(2 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			check, cancel := context.WithTimeout(ctx, 2*time.Second)
+			auth, err := c.manager.Client().ValidateSftpCredentials(check, remote.SftpAuthRequest{Type: "lease", Pass: lease})
+			cancel()
+			if err != nil || auth.User != conn.Permissions.Extensions["user"] || auth.Server != conn.Permissions.Extensions["uuid"] {
+				_ = conn.Close()
+				return
+			}
+		}
+	}
+}
